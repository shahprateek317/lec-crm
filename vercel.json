{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/reconcile-deleted-clients",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/send-session-reminders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/cleanup-totp-enrollments",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reconcile-orphan-s3-keys",
      "schedule": "45 2 * * *"
    }
  ]
}
